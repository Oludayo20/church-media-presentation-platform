{
  "name": "@cmp/desktop",
  "productName": "Church Media",
  "version": "0.0.0",
  "private": true,
  "description": "Church media & worship presentation desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "electron-vite build && playwright test",
    "dist:dir": "electron-vite build && electron-builder --dir -c.mac.identity=null"
  },
  "devDependencies": {
    "@cmp/database": "workspace:*",
    "@cmp/design-system": "workspace:*",
    "@cmp/presentation-engine": "workspace:*",
    "@cmp/shared-types": "workspace:*",
    "@cmp/shared-validation": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.4.4",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
