{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    // page.evaluate() callbacks run in the renderer, so tests need DOM types
    // and the window.cmp declaration alongside Node's.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["tests/**/*.ts", "src/env.d.ts"]
}
