digraph system_architecture {
  graph [fontname="Helvetica", fontsize=11, rankdir=LR, nodesep=0.5, ranksep=0.7, bgcolor="white"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  label="01 — System architecture"; labelloc=t;
  subgraph cluster_app { label="Electron desktop app (operator's computer)"; style=dashed; color="#4a6fa5";
    operator [label="Operator window\n(React renderer, sandboxed)\nHome · Live · Services · Presentations\nSongs · Bible · Media · Templates"];
    preload [label="Preload bridge\nwindow.cmp (typed)", fillcolor="#fff6e0"];
    main [label="Main process\nIPC router (Zod) · LiveSessionController\nDisplayManager · WindowManager\nRepositories · Updater", fillcolor="#e6f4ea"];
    audience [label="Audience window\nPresentation Engine (no React)", fillcolor="#fde8e8"];
    worker [label="utilityProcess worker\nimport · ffmpeg · pptx · backup", fillcolor="#f0e9fb"];
    db [label="SQLite + FTS5\nworkspace.db", shape=cylinder, fillcolor="#ffffff"];
    media [label="Content-addressed\nmedia store", shape=folder, fillcolor="#ffffff"];
  }
  projector [label="Projector / LED wall", shape=box3d, fillcolor="#ffffff"];
  cloud [label="Optional cloud (post-MVP)\nNestJS · Postgres · R2", style="rounded,dashed,filled", fillcolor="#f5f5f5"];
  feed [label="Update feed\nGitHub Releases / R2", style="rounded,dashed,filled", fillcolor="#f5f5f5"];
  operator -> preload -> main [label="invoke"];
  main -> audience [label="MessagePort\nlive:* (seq)"];
  audience -> main [label="engine:state", style=dashed];
  main -> db; main -> worker [label="jobs"]; worker -> media; worker -> db;
  audience -> media [label="cmp-media://"];
  audience -> projector [label="HDMI"];
  main -> cloud [label="HTTPS, best-effort", style=dashed];
  main -> feed [label="update check", style=dashed];
}
